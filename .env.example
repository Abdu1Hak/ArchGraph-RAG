# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
EXTRACTION_MODEL=gemini-3.5-flash-lite
ROUTER_MODEL=gemini-3.5-flash-lite
GENERATION_MODEL=gemini-3.5-flash-lite
# Daily-quota fallback chain (free tier: 500 RPD per flash-lite model, 14.4K RPD for gemma-4-31b-it)
FALLBACK_MODEL_1=gemini-3.5-flash-lite
FALLBACK_MODEL_2=gemini-3.1-flash-lite
FALLBACK_MODEL_3=gemma-4-31b-it
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=llmkgrag2026

# PostgreSQL + pgvector Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=llmkgrag2026
POSTGRES_DB=llm_kg_rag

# Ingestion & Budget Controls
MAX_EXTRACTION_BUDGET_USD=5.00
MIN_EXTRACTION_CONFIDENCE=0.65
ER_AUTO_MERGE_THRESHOLD=0.88
ER_GRAY_ZONE_LOW_THRESHOLD=0.82

# Phase 1B Extraction Cost Model (USD per 1M tokens, per-chunk token overheads)
EXTRACTION_INPUT_USD_PER_1M=0.15
EXTRACTION_OUTPUT_USD_PER_1M=0.60
EXTRACTION_PROMPT_OVERHEAD_TOKENS=650
EXTRACTION_OUTPUT_TOKENS_PER_CHUNK=350
ARXIV_REQUEST_DELAY_S=3.0

# Phase 5 projected query-time cost model (assumed rates for reporting; set your real prices)
ROUTER_INPUT_USD_PER_1M=0.15
ROUTER_OUTPUT_USD_PER_1M=0.60
GENERATION_INPUT_USD_PER_1M=1.25
GENERATION_OUTPUT_USD_PER_1M=10.00
EMBEDDING_USD_PER_1M=0.15
